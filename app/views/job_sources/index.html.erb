<div class="mx-auto max-w-6xl px-4 py-8">
  <h1 class="text-3xl font-bold text-slate-900">Job Crawl Admin</h1>

  <div class="mt-6 grid grid-cols-3 gap-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-sm text-slate-500">Total listings</p>
      <p class="mt-1 text-3xl font-bold text-slate-900"><%= @stats[:listings] %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-sm text-slate-500">Active listings</p>
      <p class="mt-1 text-3xl font-bold text-emerald-600"><%= @stats[:active] %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <p class="text-sm text-slate-500">Saved by users</p>
      <p class="mt-1 text-3xl font-bold text-indigo-600"><%= @stats[:saved] %></p>
    </div>
  </div>

  <h2 class="mt-10 text-lg font-semibold text-slate-900">Sources</h2>
  <div class="mt-3 overflow-hidden rounded-xl border border-slate-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-5 py-3">Source</th>
          <th class="px-5 py-3">Crawler</th>
          <th class="px-5 py-3">Listings</th>
          <th class="px-5 py-3">Last crawled</th>
          <th class="px-5 py-3 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @job_sources.each do |source| %>
          <tr>
            <td class="px-5 py-4">
              <p class="font-medium text-slate-900"><%= source.name %></p>
              <p class="text-xs text-slate-400"><%= source.base_url %></p>
            </td>
            <td class="px-5 py-4 text-slate-600">
              <%= source.crawler_class %>
              <%= "✅" unless source.active? %>
              <span class="<%= source.active? ? 'text-emerald-600' : 'text-red-500' %> text-xs">
                <%= source.active? ? "active" : "disabled" %>
              </span>
            </td>
            <td class="px-5 py-4 font-semibold"><%= source.job_listings.count %></td>
            <td class="px-5 py-4 text-slate-500">
              <%= source.last_crawled_at ? time_ago_in_words(source.last_crawled_at) + " ago" : "never" %>
            </td>
            <td class="px-5 py-4 text-right">
              <%= button_to "Crawl now", crawl_now_admin_job_source_path(source),
                    class: "rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:bg-indigo-500" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 text-lg font-semibold text-slate-900">Recent crawl sessions</h2>
  <div class="mt-3 overflow-hidden rounded-xl border border-slate-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-5 py-3">Source</th>
          <th class="px-5 py-3">Status</th>
          <th class="px-5 py-3">Found / New / Updated</th>
          <th class="px-5 py-3">When</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @crawl_sessions.each do |session| %>
          <tr>
            <td class="px-5 py-3 font-medium"><%= session.job_source&.name %></td>
            <td class="px-5 py-3"><%= crawl_status_badge(session) %></td>
            <td class="px-5 py-3 text-slate-600">
              <%= session.listings_found %> / <%= session.listings_created %> / <%= session.listings_updated %>
            </td>
            <td class="px-5 py-3 text-slate-500"><%= time_ago_in_words(session.started_at) %> ago</td>
            <td class="px-5 py-3 text-right">
              <%= link_to "Details", admin_crawl_session_path(session), class: "text-xs font-medium text-indigo-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
        <% if @crawl_sessions.empty? %>
          <tr><td colspan="5" class="px-5 py-8 text-center text-slate-400">No crawl sessions yet — click "Crawl now" above.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>