<div class="mx-auto max-w-5xl px-4 py-8">
  <h1 class="text-3xl font-bold text-slate-900">My Saved Jobs</h1>
  <p class="mt-1 text-sm text-slate-500"><%= pluralize(@saved_jobs.size, "job") %> saved</p>

  <div class="mt-6 space-y-4">
    <% if @saved_jobs.any? %>
      <% @saved_jobs.each do |saved| %>
        <% job = saved.job_listing %>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <span class="text-xs font-medium uppercase tracking-wide text-indigo-600">
                <%= job.job_source&.name || "Unknown" %>
              </span>
              <%= link_to job.title, job_listing_path(job),
                    class: "mt-0.5 block truncate text-lg font-semibold text-slate-900 hover:text-indigo-600" %>
              <p class="text-sm text-slate-600">
                <%= job.company_name %><%= " · #{job.location}" if job.location.present? %>
                · Saved <%= time_ago_in_words(saved.created_at) %> ago
              </p>
            </div>
            <div class="flex shrink-0 items-center gap-3">
              <%= button_to "Remove", saved_job_path(saved), method: :delete,
                    class: "rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50" %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
        <p class="text-slate-500">You haven't saved any jobs yet.</p>
        <%= link_to "Browse job listings", job_listings_path,
              class: "mt-3 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>
</div>