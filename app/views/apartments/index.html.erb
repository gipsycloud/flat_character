<div class="mx-auto max-w-6xl px-4 py-8">
  <!-- Header -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Find Your Home</h1>
      <p class="mt-1 text-sm text-slate-500"><%= pluralize(@total, "apartment") %> found</p>
    </div>
    <% if user_signed_in? %>
      <%= link_to "+ List your apartment", new_admin_apartment_path,
            class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
    <% end %>
  </div>

  <!-- Filters -->
  <%= form_with url: admin_apartments_path, method: :get,
        class: "mt-6 grid grid-cols-2 gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-3 lg:grid-cols-6" do %>
    <div>
      <%= label_tag :city, "City", class: "text-xs font-medium text-slate-500" %>
      <%= select_tag :city,
            options_for_select([["Any city", ""]] + @cities.map { |c| [c, c] }, params[:city]),
            class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= label_tag :lifestyle_mode, "Lifestyle", class: "text-xs font-medium text-slate-500" %>
      <%= select_tag :lifestyle_mode,
            options_for_select([["Any lifestyle", ""]] + Apartment.lifestyle_modes.keys.map { |k| [k.humanize, k] }, params[:lifestyle_mode]),
            class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= label_tag :max_rent, "Max rent", class: "text-xs font-medium text-slate-500" %>
      <%= number_field_tag :max_rent, params[:max_rent], min: 0, placeholder: "e.g. 500000",
            class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= label_tag :bedrooms, "Bedrooms", class: "text-xs font-medium text-slate-500" %>
      <%= select_tag :bedrooms,
            options_for_select([["Any", ""], ["1+", "1"], ["2+", "2"], ["3+", "3"]], params[:bedrooms]),
            class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= label_tag :sort, "Sort by", class: "text-xs font-medium text-slate-500" %>
      <%= select_tag :sort,
            options_for_select([["Newest", ""], ["Rent: low → high", "price_asc"], ["Rent: high → low", "price_desc"]], params[:sort]),
            class: "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex items-end gap-2">
      <%= submit_tag "Filter", class: "w-full rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
      <%= link_to "Reset", admin_apartments_path, class: "text-xs text-slate-500 hover:text-slate-800" %>
    </div>
  <% end %>

  <!-- Cards -->
  <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% @apartments.each do |apartment| %>
      <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-lg">
        <div class="relative h-32 bg-gradient-to-br <%= lifestyle_gradient(apartment.lifestyle_mode) %>">
          <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-0.5 text-xs font-semibold text-slate-700 backdrop-blur">
            <%= apartment.lifestyle_mode.humanize %> living
          </span>
          <% if apartment.status == "occupied" %>
            <span class="absolute right-3 top-3 rounded-full bg-slate-900/80 px-2.5 py-0.5 text-xs font-semibold text-white">Occupied</span>
          <% end %>
          <div class="absolute bottom-3 left-3 text-white drop-shadow">
            <p class="text-xl font-bold"><%= apartment.currency %> <%= number_with_delimiter(apartment.monthly_rent) %></p>
            <p class="text-xs opacity-90">per month</p>
          </div>
        </div>

        <div class="flex flex-1 flex-col p-4">
          <%= link_to apartment.title, admin_apartment_path(apartment),
                class: "line-clamp-1 text-lg font-semibold text-slate-900 hover:text-indigo-600" %>
          <p class="mt-0.5 line-clamp-1 text-sm text-slate-500">
            <%= [apartment.address, apartment.city].compact.reject(&:blank?).join(", ") %>
          </p>

          <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-600">
            <span class="rounded-lg bg-slate-100 px-2 py-1"><%= apartment.bedrooms %> bed</span>
            <span class="rounded-lg bg-slate-100 px-2 py-1"><%= apartment.bathrooms %> bath</span>
            <% if apartment.size_m2.present? %>
              <span class="rounded-lg bg-slate-100 px-2 py-1"><%= apartment.size_m2 %> m²</span>
            <% end %>
          </div>

          <% if apartment.available_from.present? && apartment.available_from > Date.current %>
            <p class="mt-2 text-xs text-amber-600">Available from <%= apartment.available_from.strftime("%b %d, %Y") %></p>
          <% end %>

          <div class="mt-auto flex items-center justify-between border-t border-slate-100 pt-3">
            <span class="text-xs text-slate-400">Listed <%= time_ago_in_words(apartment.created_at) %> ago</span>
            <% if user_signed_in? %>
              <% fav = favorite_apartment_map[apartment.id] %>
              <% if fav %>
                <%= button_to "♥ Saved", admin_favorite_path(fav), method: :delete,
                      class: "rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50" %>
              <% else %>
                <%= button_to "♡ Save", admin_apartment_favorites_path(apartment),
                      class: "rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Empty state -->
  <% if @apartments.empty? %>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <p class="text-slate-500">No apartments match your filters.</p>
      <%= link_to "Reset filters", admin_apartments_path, class: "mt-3 inline-block text-sm font-medium text-indigo-600 hover:underline" %>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @pages > 1 %>
    <div class="mt-8 flex items-center justify-between">
      <% if @page > 1 %>
        <%= link_to "← Previous", admin_apartments_path(request.query_parameters.merge(page: @page - 1)),
              class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50" %>
      <% else %><span></span><% end %>
      <span class="text-sm text-slate-500">Page <%= @page %> of <%= @pages %></span>
      <% if @page < @pages %>
        <%= link_to "Next →", admin_apartments_path(request.query_parameters.merge(page: @page + 1)),
              class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50" %>
      <% else %><span></span><% end %>
    </div>
  <% end %>
</div>