<h1>Job Sources</h1>
<table>
  <thead>
    <tr><th>Name</th><th>Last crawled</th><th></th></tr>
  </thead>
  <tbody>
    <% @job_sources.each do |source| %>
      <tr>
        <td><%= source.name %></td>
        <td><%= source.last_crawled_at&.strftime("%Y-%m-%d %H:%M") || "never" %></td>
        <td><%= button_to "Crawl now", crawl_now_admin_job_source_path(source) %></td>
      </tr>
    <% end %>
  </tbody>
</table>