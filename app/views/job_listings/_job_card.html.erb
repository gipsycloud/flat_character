<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium uppercase tracking-wide text-indigo-600">
          <%= job.job_source&.name || "Unknown" %>
        </span>
        <% if job.remote_status == "remote" %>
          <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">Remote</span>
        <% elsif job.remote_status == "hybrid" %>
          <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">Hybrid</span>
        <% end %>
        <% if job.employment_type.present? %>
          <span class="text-xs text-slate-400"><%= job.employment_type.humanize %></span>
        <% end %>
      </div>

      <%= link_to job.title, admin_job_listing_path(job),
            class: "mt-1 block truncate text-lg font-semibold text-slate-900 hover:text-indigo-600" %>
      <p class="mt-0.5 text-sm text-slate-600">
        <%= job.company_name %><%= " · #{job.location}" if job.location.present? %>
      </p>
    </div>


    <div class="shrink-0 rounded-lg bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-700">
      <%= job.salary_min %><%= job.salary_max.present? ? " - #{job.salary_max}" : "" %>s
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
    <span class="text-xs text-slate-400">
      <%= "Posted #{time_ago_in_words(job.posted_at)} ago" if job.posted_at.present? %>
    </span>

    <% if user_signed_in? %>
      <% if saved_job_ids.include?(job.id) %>
        <%= button_to "Remove", saved_job_path(current_user.saved_jobs.find_by(job_listing_id: job.id)),
              method: :delete, class: "text-xs font-medium text-slate-500 hover:text-red-600" %>
      <% else %>
        <%= button_to "Save job", admin_saved_jobs_path(job_listing_id: job.id),
              class: "rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500" %>
      <% end %>
    <% end %>
  </div>
</div>