<div class="mx-auto max-w-3xl px-4 py-8">
  <%= link_to "← All jobs", admin_job_listings_path, class: "text-sm text-slate-500 hover:text-slate-800" %>

  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
        <%= @job_listing.job_source&.name || "Unknown source" %>
      </span>
      <% if @job_listing.remote_status == "remote" %>
        <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Remote</span>
      <% end %>
      <% if @job_listing.employment_type.present? %>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
          <%= @job_listing.employment_type.humanize %>
        </span>
      <% end %>
    </div>

    <h1 class="mt-3 text-2xl font-bold text-slate-900"><%= @job_listing.title %></h1>
    <p class="mt-1 text-slate-600">
      <span class="font-medium"><%= @job_listing.company_name %></span>
      <%= " · #{@job_listing.location}" if @job_listing.location.present? %>
      <% if @job_listing.salary_max.present? %> · <%= @job_listing.salary %><% end %>
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <% if user_signed_in? %>
        <% if saved_job_ids.include?(@job_listing.id) %>
          <%= button_to "Remove from saved",
                saved_job_path(current_user.saved_jobs.find_by(job_listing_id: @job_listing.id)),
                method: :delete,
                class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
        <% else %>
          <%= button_to "Save this job", admin_saved_jobs_path(job_listing_id: @job_listing.id),
                class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
        <% end %>
      <% end %>
      <%= link_to "View original posting →", @job_listing.source_url, target: "_blank", rel: "noopener",
            class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    </div>

    <div class="mt-8 border-t border-slate-100 pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Job description</h2>
      <div class="prose prose-slate mt-3 max-w-none text-slate-700">
        <%= simple_format(@job_listing.description.presence || "No description provided.") %>
      </div>
    </div>
  </div>
</div>